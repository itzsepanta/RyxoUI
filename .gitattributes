# Normalise line endings so the tree behaves the same on every platform.
* text=auto eol=lf

*.go text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.tar.gz binary
